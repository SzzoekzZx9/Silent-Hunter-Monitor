# Silent Hunter Monitor configuration
#
# Copy this file to .env and fill in your values:
#     cp .env.example .env
#
# .env is gitignored — never commit real credentials.
# Every value here can also be set as a real environment variable
# (real env vars override .env entries).

# ---------------------------------------------------------------------------
# Feature switches
# ---------------------------------------------------------------------------
# XMPP notifications (notify.py). Off by default.
SH3_NOTIFY_ENABLED=false

# Patrol log writer: LLM-generated daily recaps written to a Gollum wiki
# (collectors/patrol_log.py). Off by default.
SH3_PATROL_LOG_ENABLED=false

# ---------------------------------------------------------------------------
# XMPP notifications (required when SH3_NOTIFY_ENABLED=true)
# ---------------------------------------------------------------------------
# Sender JID, e.g. "bot@example.com"
SH3_XMPP_JID=
# Password for the sender JID
SH3_XMPP_PASSWORD=
# Recipient JID, e.g. "you@example.com"
SH3_XMPP_RECIPIENT=

# ---------------------------------------------------------------------------
# Patrol log writer (required when SH3_PATROL_LOG_ENABLED=true)
# ---------------------------------------------------------------------------
# OpenAI-compatible API base URL, e.g. "http://localhost:8080/v1"
SH3_LLM_URL=
# API key (optional; some local servers need none)
SH3_LLM_KEY=
# Model name to request
SH3_LLM_MODEL=
# Gollum wiki base URL, e.g. "https://wiki.example.com"
SH3_WIKI_URL=
# Wiki directory holding the patrol pages
SH3_WIKI_DIR=Games/SH3 Captain's Log
# Fixed patrol page path (OVERRIDE — bypasses patrol-number routing; unset
# by default)
#SH3_WIKI_PAGE=

# ---------------------------------------------------------------------------
# Patrol log writer — optional tuning (defaults shown)
# ---------------------------------------------------------------------------
# Completion budget (reasoning tokens included)
#SH3_LLM_MAX_TOKENS=2048
# Request timeout in seconds (safety net; requests are streamed)
#SH3_LLM_TIMEOUT=3600
# llama-swap priority header value (higher = served first)
#SH3_LLM_PRIORITY=20
# Header name carrying the priority
#SH3_LLM_PRIORITY_HEADER=X-llamaswap-Priority
# Seconds to wait before retrying failed recaps
#SH3_PATROL_RETRY_DELAY=300
# Journal file path (pending recap state)
#SH3_PATROL_JOURNAL=.sh3_patrol_log_journal.json